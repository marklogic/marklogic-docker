FROM registry.access.redhat.com/ubi9/ubi-minimal:9.8-1786987521 AS platform
LABEL "com.marklogic.maintainer"="docker@marklogic.com"

# Extra UBI-repo packages for the platform image, space separated
ARG PLATFORM_EXTRA_PACKAGES=""

###############################################################
# update glibc from UBI repositories
###############################################################

RUN microdnf -y upgrade glibc \
    && microdnf clean all

###############################################################
# install gdb and dependencies for stack traces, networking, base deps and tzdata for timezone
###############################################################
# hadolint ignore=DL3006,SC2086
RUN echo "NETWORKING=yes" > /etc/sysconfig/network \
    && microdnf -y install --setopt install_weak_deps=0 gdb python3-rpm nss libcap procps-ng python3 libtool-ltdl cpio initscripts tzdata glibc libstdc++ util-linux hostname ${PLATFORM_EXTRA_PACKAGES} \
    && microdnf clean all


###############################################################
# Enable FIPS Mode
###############################################################
RUN update-crypto-policies --set FIPS

###############################################################
# deps image: platform plus non-UBI content
# install libnsl rpm package
###############################################################
FROM platform AS deps

RUN rpm -i https://download.rockylinux.org/pub/rocky/9.8/BaseOS/aarch64/os/Packages/l/libnsl-2.34-275.el9_8.aarch64.rpm
